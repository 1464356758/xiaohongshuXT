{
  "schema": "SYS-003_WORKFLOW_GRAPH_V3",
  "formal_router": "R01",
  "formal_paths": {
    "asset_identity_gate": "系统/生产架构/SYS-003/ASSET_IDENTITY_GATE.json",
    "audit_policy": "系统/建设审核协议V2.json",
    "state_phase_table": "系统/生产架构/SYS-003/STATE_PHASE_TRANSITION_TABLE.json",
    "content_lock_template": "模板/锁定/CONTENT_LOCK_TEMPLATE.json",
    "compliance_snapshot_template": "模板/生产/COMPLIANCE_SNAPSHOT_TEMPLATE.json"
  },
  "runtime_gate": "真实CONTENT-*要求生产/当前进度.runtime_enabled=true；CONTENT-TEST-*仅可在TEST_ONLY。",
  "stages": [
    {
      "id": "S0A_STRATEGY_SETUP",
      "type": "CONDITIONAL",
      "sequence": [
        "R16_DRAFT",
        "R01_APPROVE_OR_REJECT_STRATEGY",
        "R01_CONSUME_TRIGGER"
      ]
    },
    {
      "id": "S0B_VOICE_SETUP",
      "type": "CONDITIONAL",
      "sequence": [
        "R07_VOICE_DRAFT",
        "R13_TRUTH_CHECK",
        "R01_APPROVE_VOICE_LOCK"
      ]
    },
    {
      "id": "S0C_PERSONA_SETUP",
      "type": "CONDITIONAL_SERIAL",
      "trigger": "active_persona_lock_path == null OR user_requests_persona_change",
      "sequence": [
        "R08_PERSONA_DRAFT",
        "R11_INDEPENDENT_PERSONA_REVIEW",
        "R01_APPROVE_NEW_PERSONA_LOCK"
      ],
      "rule": "换人必须新PERSONA LOCK版本+supersedes，禁止覆盖旧LOCK。"
    },
    {
      "id": "S1_DISCOVERY",
      "type": "PARALLEL_BARRIER",
      "roles": [
        "R02",
        "R03"
      ],
      "barrier": "ALL_REQUIRED_COMPLETE_WITH_EVIDENCE"
    },
    {
      "id": "S2_PRODUCT_RESEARCH",
      "type": "SERIAL",
      "sequence": [
        "R01_CANDIDATE_SET",
        "R04_DEEP_RESEARCH",
        "R01_FORMAL_PRODUCT_SELECT",
        "R05_PRODUCT_SKU_DRAFT",
        "R01_APPROVE_PRODUCT_SKU_LOCK"
      ]
    },
    {
      "id": "S3_CONTENT",
      "type": "SERIAL",
      "sequence": [
        "R06",
        "R01_STAGE_APPROVAL",
        "R07"
      ],
      "required": [
        "ACCOUNT_STRATEGY_LOCK",
        "VOICE_LOCK",
        "PRODUCT/SKU LOCK where applicable"
      ]
    },
    {
      "id": "S4_VISUAL",
      "type": "SERIAL",
      "sequence": [
        "R08",
        "R09",
        "ASSET_IDENTITY_GATE",
        "R01_ACTIVATE_MANIFEST"
      ]
    },
    {
      "id": "S5_IMAGE_QA",
      "type": "PARALLEL_BARRIER",
      "roles": [
        "R10",
        "R11",
        "R12"
      ],
      "barrier": "ALL_THREE_PASS_SAME_MANIFEST_WITH_ACTIVE_POINTERS"
    },
    {
      "id": "S6A_COMPLIANCE_REFRESH",
      "type": "CONDITIONAL_SERIAL",
      "trigger": "无active快照/过期/未核实/scope不匹配",
      "sequence": [
        "R01_REFRESH_TASK",
        "R13_DRAFT_OR_REFRESH",
        "R01_ACTIVATE_SNAPSHOT"
      ]
    },
    {
      "id": "S6B_CONTENT_COMPLIANCE",
      "type": "SERIAL_HARD_GATE",
      "role": "R13",
      "precondition": "快照VALID+时间有效+scope fingerprint精确匹配+当前图片三审"
    },
    {
      "id": "S7_CONTENT_LOCK",
      "type": "SERIAL_HARD_GATE",
      "role": "R01",
      "precondition": "CONTENT_LOCK机械检查全部通过"
    },
    {
      "id": "S8_PUBLISH",
      "type": "SERIAL",
      "sequence": [
        "R14_PUBLISH_PACKAGE",
        "USER_ACTUAL_PUBLISH",
        "R14_PUBLISH_RECEIPT",
        "R01_CONFIRM_PUBLISHED"
      ]
    },
    {
      "id": "S9_RAW_DATA",
      "type": "MANUAL_TRIGGER_WINDOWS",
      "role": "R14",
      "windows": [
        "24h",
        "72h",
        "7d"
      ],
      "status": [
        "DUE",
        "RECORDED",
        "MISSED"
      ]
    },
    {
      "id": "S10_ANALYSIS",
      "type": "SERIAL",
      "sequence": [
        "R15_ANALYZE",
        "R01_CONFIRM_DATA_REVIEWED"
      ]
    },
    {
      "id": "S11_STRATEGY_TRIGGER",
      "type": "CONDITIONAL",
      "rule": "R01按CONTENT LOCK计数/其他信号生成唯一PENDING trigger_event_id；CONSUMED后不可重复消费。"
    },
    {
      "id": "S12_NEXT",
      "type": "R01_DECISION"
    }
  ],
  "hard_invariants": [
    "禁止扫描目录找PASS",
    "第一人称经历必须绑定当前公开博主人格及证据",
    "合规=时间有效+scope匹配",
    "runtime=false阻止真实生产",
    "A/B/C系统审核全部PASS后才可模块LOCK"
  ]
}