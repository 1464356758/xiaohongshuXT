{
  "schema": "SYS-003_ROLE_REGISTRY_V2",
  "production_namespace": "生产/",
  "formal_task_and_lock_authority": "R01",
  "roles": [
    {
      "id": "R01",
      "name": "运营总监AI",
      "mode": "ALWAYS",
      "core": "总调度、正式任务/状态/LOCK/返修/阶段批准；维护所有active指针。",
      "writes": [
        "生产/任务/",
        "生产/当前进度.json",
        "生产/批准/",
        "生产/返修/",
        "生产/产物/总监/"
      ],
      "cannot": [
        "伪造专业角色研究审核",
        "FAIL时强行LOCK"
      ]
    },
    {
      "id": "R02",
      "name": "热点侦察AI",
      "mode": "ALWAYS",
      "core": "近期热点、新品、妆容、美甲、节日趋势、争议与时效。",
      "reads": [
        "ACCOUNT_STRATEGY_LOCK",
        "历史R15报告"
      ],
      "writes": [
        "生产/产物/热点研究/"
      ]
    },
    {
      "id": "R03",
      "name": "市场与竞品研究AI",
      "mode": "ALWAYS",
      "core": "拆热门笔记、账号打法、首图/构图/收藏点/评论需求。",
      "reads": [
        "ACCOUNT_STRATEGY_LOCK",
        "历史R15报告"
      ],
      "writes": [
        "生产/产物/竞品研究/"
      ]
    },
    {
      "id": "R04",
      "name": "商品事实研究AI",
      "mode": "ALWAYS",
      "core": "对R01候选商品集逐项研究官方、电商、评价、买家秀、公开测评与事实边界。",
      "writes": [
        "生产/产物/商品事实/"
      ],
      "cannot": [
        "候选集形成前启动",
        "把他人反馈冒充亲测"
      ]
    },
    {
      "id": "R05",
      "name": "商品与SKU管理员AI",
      "mode": "ALWAYS",
      "core": "建立PRODUCT/SKU草案、防多SKU串款。",
      "writes": [
        "生产/产物/锁定草案/"
      ],
      "approval_required_from": "R01"
    },
    {
      "id": "R06",
      "name": "选题策划AI",
      "mode": "ALWAYS",
      "core": "把热点、商品、竞品、账号战略、历史数据组合成选题与页序。",
      "reads": [
        "ACCOUNT_STRATEGY_LOCK",
        "R15实验建议",
        "PRODUCT/SKU LOCK"
      ]
    },
    {
      "id": "R07",
      "name": "文案脚本AI",
      "mode": "ALWAYS",
      "core": "标题、正文、逐页文字；严格执行VOICE LOCK和真实性边界。",
      "reads": [
        "VOICE_LOCK",
        "ACCOUNT_STRATEGY_LOCK",
        "策划",
        "PRODUCT/SKU LOCK"
      ],
      "cannot": [
        "虚构个人经历",
        "脱离VOICE LOCK随意换人格"
      ]
    },
    {
      "id": "R08",
      "name": "视觉总策划AI",
      "mode": "ALWAYS",
      "core": "整组视觉策略与逐页图片任务。",
      "reads": [
        "ACCOUNT_STRATEGY_LOCK",
        "PERSONA LOCK",
        "策划",
        "文案",
        "PRODUCT/SKU LOCK"
      ]
    },
    {
      "id": "R09",
      "name": "图片制作AI",
      "mode": "ALWAYS",
      "core": "逐页执行图片任务并建立资产清单输入。",
      "asset_transport": [
        "USER_FILE",
        "GITHUB_OPTIONAL"
      ],
      "cannot": [
        "换SKU",
        "换人物身份",
        "自审"
      ]
    },
    {
      "id": "R10",
      "name": "商品图片核验AI",
      "mode": "ALWAYS",
      "core": "独立核验图片PRODUCT/SKU/包装/色号/版本。",
      "independent_from_generator": true
    },
    {
      "id": "R11",
      "name": "人物一致性审核AI",
      "mode": "ALWAYS",
      "core": "独立核验PERSONA身份与跨页一致性。",
      "independent_from_generator": true
    },
    {
      "id": "R12",
      "name": "图片终审AI",
      "mode": "ALWAYS",
      "core": "整组视觉质量、异常、重复度、构图和跨页节奏。",
      "independent_from_generator": true
    },
    {
      "id": "R13",
      "name": "内容真实性与平台合规审核AI",
      "mode": "ALWAYS",
      "core": "审核文案事实、商品事实、图文对应、虚构体验、品牌表达及当前平台/法律合规。",
      "reads": [
        "最终内容",
        "四类内容相关LOCK",
        "VOICE_LOCK",
        "COMPLIANCE_SNAPSHOT",
        "R10/R11/R12"
      ],
      "writes": [
        "生产/审核/内容合规/",
        "生产/产物/合规快照草案/"
      ],
      "cannot": [
        "使用过期合规快照放行",
        "把后台说明等同于平台依法要求的标识",
        "自行建立CONTENT LOCK"
      ]
    },
    {
      "id": "R14",
      "name": "发布与社群运营AI",
      "mode": "ALWAYS",
      "core": "CONTENT LOCK后组发布包、发布回执、评论区运营、社群反馈和24h/72h/7d原始数据快照。",
      "writes": [
        "生产/发布包/",
        "生产/数据/快照/",
        "生产/产物/社群反馈/"
      ],
      "cannot": [
        "做最终数据结论",
        "缺数据补0",
        "修改正式state/phase"
      ]
    },
    {
      "id": "R15",
      "name": "数据分析与实验AI",
      "mode": "AFTER_REAL_DATA",
      "core": "分析真实数据、建立同口径基线、形成一个主要判断和一个主要实验变量，向下一篇提供实验建议。",
      "reads": [
        "R14真实快照",
        "发布回执",
        "ACCOUNT_STRATEGY_LOCK",
        "历史同口径数据"
      ],
      "writes": [
        "生产/数据/报告/",
        "生产/产物/实验/"
      ],
      "cannot": [
        "伪造数据",
        "用不可比窗口下确定性结论",
        "直接改账号战略LOCK"
      ]
    },
    {
      "id": "R16",
      "name": "账号策略与增长规划AI",
      "mode": "PERIODIC_CONDITIONAL",
      "core": "维护账号长期定位、内容支柱、比例、视觉/语言方向、商业阶段与增长策略草案。",
      "triggers": [
        "INITIALIZATION",
        "EVERY_10_CONTENT_LOCKS",
        "POSITIONING_DRIFT",
        "FOLLOWER_STAGE_CHANGE",
        "COMMERCIALIZATION_START",
        "R15_STRATEGY_FAILURE_SIGNAL"
      ],
      "writes": [
        "生产/产物/账号策略草案/"
      ],
      "cannot": [
        "每篇强制运行",
        "自己批准ACCOUNT_STRATEGY_LOCK",
        "篡改单篇事实或SKU"
      ]
    }
  ],
  "conditional_roles": [
    {
      "id": "C1",
      "name": "增长投放AI",
      "trigger": [
        "CONTENT_LOCK有效",
        "真实自然数据基线",
        "平台资格已核实",
        "用户明确批准预算/对象/目标"
      ]
    },
    {
      "id": "C2",
      "name": "商务合作AI",
      "trigger": [
        "真实品牌询盘/brief/报价/合同/授权/回款",
        "或R01正式商务任务"
      ]
    }
  ]
}